# Copy to .env and fill in. .env is gitignored — never commit real values.

# dev | prod — picks which Supabase project + DB the backend talks to
APP_ENV=dev

SUPABASE_URL_DEV=https://jtgyttbobxtxgtnmuyas.supabase.co
SUPABASE_SERVICE_KEY_DEV=
SUPABASE_JWT_SECRET_DEV=
DATABASE_URL_DEV=

SUPABASE_URL_PROD=https://vcluruaueetktctdyplh.supabase.co
SUPABASE_SERVICE_KEY_PROD=
SUPABASE_JWT_SECRET_PROD=
DATABASE_URL_PROD=

# Cloudflare Workers AI (images + embeddings)
CF_ACCOUNT_ID=5790e6bb8b193165d6ce7707fc5e8b39
CF_API_TOKEN=

# DeepInfra — paid PAYG image backstop for when Cloudflare fails/limits.
# No free tier on DeepInfra itself (~$0.0005/image) — sign up at
# deepinfra.com and generate a key. Governed by a monthly spend cap in
# cost_status.py, not just left uncapped.
DEEPINFRA_API_KEY=

# OpenRouter — primary text/tool-use provider (free models)
OPENROUTER_API_KEY=

# Groq — independent fallback if OpenRouter errors/429s/roster changes.
# Called directly (OpenAI-compatible), never routed through OpenRouter BYOK —
# keeps this a genuine second upstream, not the same failure domain.
GROQ_API_KEY=

# Anthropic — deferred. Provider-agnostic config picks OpenRouter unless this
# is set, so filling it in later is the entire "upgrade" to Claude Haiku.
ANTHROPIC_API_KEY=

# Resend — sandbox mode, no domain needed yet. Sends from onboarding@resend.dev
# to the one verified recipient below only (Alejandro + Ken for now).
RESEND_API_KEY=
RESEND_SANDBOX_RECIPIENT=

SENTRY_DSN=

# Shared secret Cloud Scheduler sends as a header to trigger cron endpoints
# (pool_warmer, later lifecycle_scheduler) — Scheduler isn't a logged-in user,
# so it can't use a Supabase JWT. Generate any long random string.
CRON_SECRET=

# Separate secret for the Supabase DB webhook (meal_weeks INSERT -> /api/webhooks/meal-ready).
# Deliberately distinct from CRON_SECRET — this one also lives in Supabase's
# vault, a different trust boundary than GCP's Cloud Run env vars.
WEBHOOK_SECRET=

# Paid escape hatches. TEXT_PAID_MODE stays false/default. IMAGE_PAID_BACKSTOP
# defaults true — DeepInfra is the only remaining image fallback since
# Pollinations was removed, and it's cheap + capped (see cost_status.py).
TEXT_PAID_MODE=false
IMAGE_PAID_BACKSTOP=true
